{%- comment -%}
  Contact page: big title on a heavy rule, then two ruled cells: the page's
  own content (Online Store → Pages → Contact) on the left, the form on the
  right. Stacked on phones. Styles: assets/contact-page.css.
{%- endcomment -%}

{{ 'contact-page.css' | asset_url | stylesheet_tag }}

<section class="contact-page" data-section-id="{{ section.id }}" data-section-type="page-section">
  <div class="contact-page__head">
    <h1 class="contact-page__title">{{ page.title }}</h1>
    <p class="contact-page__meta">Inquiries</p>
  </div>

  <div class="contact-page__grid">
    <div class="contact-page__cell contact-page__cell--intro">
      <p class="contact-page__label"><span>00</span> Reach out</p>
      <div class="contact-page__intro rte">{{ page.content }}</div>
    </div>

    <div class="contact-page__cell contact-page__cell--form">
      <p class="contact-page__label"><span>01</span> Form</p>
      {% render 'contact' %}
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Page options",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_narrow_page",
        "label": "Reduced page width",
		"info": "For narrow pages"
      },
      {
        "type": "link_list",
        "id": "pagelist",
        "label": "Choose a menu for the page sidebar",
		"info": "When page full width only"
      },
      {
        "type": "text",
        "id": "page_sidebar_title",
        "label": "Page sidebar title",
        "default": "Page sidebar title",
		"info": "When sidebar menu chosen"
      }
    ]
  }
{% endschema %}
