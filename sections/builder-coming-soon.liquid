{%- comment -%}
  Placeholder for the future 3D grillz builder (/pages/builder).
{%- endcomment -%}

{{ 'builder-coming-soon.css' | asset_url | stylesheet_tag }}

<section class="builder-soon">
  <div class="builder-soon__card">
    <p class="builder-soon__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1 class="builder-soon__title">{{ section.settings.heading | escape }}</h1>
    <p class="builder-soon__text">{{ section.settings.text | escape }}</p>
    <div class="builder-soon__actions">
      <a class="builder-soon__button builder-soon__button--primary" href="{{ section.settings.primary_url | default: '/pages/contact' }}">{{ section.settings.primary_label | escape }}</a>
      <a class="builder-soon__button" href="{{ section.settings.secondary_url | default: '/' }}">{{ section.settings.secondary_label | escape }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Builder coming soon",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Coming soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Grillz Builder" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Design your own set in 3D: pick teeth, shapes, metals and finishes, and see it from every angle before it's made. In the meantime, reach out to start a custom piece."
    },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Start a custom piece" },
    { "type": "url", "id": "primary_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "See past work" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" }
  ]
}
{% endschema %}
