{%- comment -%}
  Homepage grid of past work. Two tiles per row on phones, more on wider
  screens. Tapping a tile opens a sheet with the piece's photos/videos and a
  link to inquire about a similar piece; the product page is linked too.
  Each tile carries its sheet content in a <template>, so nothing heavy
  (videos, extra photos) loads until a tile is opened.
{%- endcomment -%}

{{ 'featured-works.css' | asset_url | stylesheet_tag }}

{%- assign works_handle = section.settings.collection | default: 'featured-works' -%}
{%- assign works = collections[works_handle] -%}
{%- assign contact_url = section.settings.inquire_url | default: '/pages/contact' -%}

<section class="featured-works" data-featured-works>
  {%- if section.settings.heading != blank -%}
    <h2 class="featured-works__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <ul class="featured-works__grid" role="list">
    {%- for product in works.products limit: section.settings.limit -%}
      {%- assign cover = product.featured_image -%}
      <li class="featured-works__item">
        <button type="button" class="featured-works__tile" data-work-open aria-haspopup="dialog">
          {%- if cover -%}
            {{ cover | image_url: width: 900 | image_tag:
              widths: '300, 450, 600, 900',
              sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 33vw, 50vw',
              loading: 'lazy',
              class: 'featured-works__image',
              alt: cover.alt | default: product.title }}
          {%- endif -%}
          <span class="featured-works__title">{{ product.title }}</span>
        </button>

        <template data-work-sheet>
          <div class="work-sheet__media">
            {%- for media in product.media -%}
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {{ media | image_url: width: 1200 | image_tag:
                    widths: '600, 900, 1200',
                    sizes: '(min-width: 750px) 560px, 100vw',
                    loading: 'lazy',
                    class: 'work-sheet__slide',
                    alt: media.alt | default: product.title }}
                {%- when 'video' -%}
                  {{ media | video_tag:
                    class: 'work-sheet__slide',
                    controls: false,
                    autoplay: false,
                    loop: true,
                    muted: true,
                    playsinline: true,
                    preload: 'none',
                    image_size: '1200x' }}
              {%- endcase -%}
            {%- endfor -%}
          </div>
          <div class="work-sheet__body">
            <h3 class="work-sheet__title">{{ product.title }}</h3>
            {%- if product.description != blank -%}
              <p class="work-sheet__text">{{ product.description | strip_html | truncatewords: 40 }}</p>
            {%- endif -%}
            <div class="work-sheet__actions">
              <a class="work-sheet__inquire" href="{{ contact_url }}?piece={{ product.title | url_encode }}">Inquire about a piece like this</a>
              <a class="work-sheet__details" href="{{ product.url }}">View details</a>
            </div>
          </div>
        </template>
      </li>
    {%- endfor -%}
  </ul>

  <dialog class="work-sheet" data-work-dialog aria-label="Piece details">
    <button type="button" class="work-sheet__close" data-work-close aria-label="Close">&times;</button>
    <div class="work-sheet__content" data-work-content></div>
  </dialog>
</section>

<script src="{{ 'featured-works.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Featured works",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured works"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Defaults to Featured Works."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Pieces shown",
      "min": 2,
      "max": 50,
      "step": 2,
      "default": 24
    },
    {
      "type": "url",
      "id": "inquire_url",
      "label": "Inquiry page",
      "info": "The piece name is passed along and prefilled in the contact form."
    }
  ]
}
{% endschema %}
