{%- assign menu = linklists[section.settings.main_nav] -%}
{%- assign link_count = menu.links.size -%}

{%- comment -%}
  Where the menu breaks around the logo. 0 (the default) splits at the midpoint
  with any odd link falling on the left, which is what the sketch shows for a
  four link menu. Anything higher is used verbatim so the split can be nudged
  from the theme editor without touching the menu itself.
{%- endcomment -%}
{%- assign split_at = section.settings.links_left -%}
{%- if split_at == 0 -%}
  {%- assign split_at = link_count | plus: 1 | divided_by: 2 -%}
{%- endif -%}
{%- if split_at > link_count -%}
  {%- assign split_at = link_count -%}
{%- endif -%}

{%- comment -%}
  Line icons: 1.75 stroke, square caps and mitred joins to match the ruled,
  hard-edged header. Inline so they inherit currentColor.
{%- endcomment -%}
{%- capture icon_menu -%}<svg class="site-header__svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h18M3 12h18M3 18h18"/></svg>{%- endcapture -%}
{%- capture icon_search -%}<svg class="site-header__svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/></svg>{%- endcapture -%}
{%- capture icon_account -%}<svg class="site-header__svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v2"/></svg>{%- endcapture -%}
{%- capture icon_bag -%}<svg class="site-header__svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 8h16v13H4z"/><path d="M8.5 8V6a3.5 3.5 0 0 1 7 0v2"/></svg>{%- endcapture -%}
{%- capture icon_instagram -%}<svg class="site-header__svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3.5 3.5h17v17h-17z"/><circle cx="12" cy="12" r="4"/><path d="M17 7h.01"/></svg>{%- endcapture -%}

{%- assign ig_url = section.settings.instagram_url -%}
{%- if ig_url == blank and settings.instagram_id != blank -%}
  {%- assign ig_url = 'https://www.instagram.com/' | append: settings.instagram_id | append: '/' -%}
{%- endif -%}

{%- capture account_cell -%}
  {%- if shop.customer_accounts_enabled -%}
    {%- if customer -%}
      <a class="site-header__cell site-header__cell--icon" href="{{ routes.account_url }}" aria-label="{{ 'layout.mobile_nav.account' | t }}">{{ icon_account }}</a>
    {%- else -%}
      <a class="site-header__cell site-header__cell--icon" href="{{ routes.account_login_url }}" aria-label="{{ 'layout.mobile_nav.login' | t }}">{{ icon_account }}</a>
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture bag_cell -%}
  <a class="site-header__cell site-header__cell--icon site-header__bag" href="{{ routes.cart_url }}" aria-label="{{ 'layout.header.my_cart' | t }}">
    {{ icon_bag }}
    <span class="site-header__count{% if cart.item_count == 0 %} is-empty{% endif %}" id="item_count" data-cart-count>{{ cart.item_count }}</span>
  </a>
{%- endcapture -%}

{%- capture search_cell -%}
  <button type="button" class="site-header__cell site-header__cell--icon" data-search-open aria-label="{{ 'general.search.placeholder' | t }}" aria-expanded="false" aria-controls="SearchOverlay">{{ icon_search }}</button>
{%- endcapture -%}

{{ 'header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header.js' | asset_url }}" defer></script>

<div class="header-section" data-section-id="{{ section.id }}" data-section-type="header-section">

  {%- if section.settings.show_announcement_text and section.settings.announcement_text != blank -%}
    {%- comment -%}
      Sits above the sticky header in normal flow, so it simply scrolls away.
    {%- endcomment -%}
    <div class="announcement-bar">
      <div class="announcement-bar__inner">{{ section.settings.announcement_text }}</div>
    </div>
  {%- endif -%}

  {%- comment -%}
    One ruled strip, fixed height at every scroll position (nothing resizes
    or slides on scroll, so the controls never move).
    Grid: two equal 1fr halves either side of a fixed logo cell, so the logo
    is dead centre. Each half is a row of cells divided by 1px rules: square
    utility cells on the outer edges, menu links filling the rest.
      desktop:  [IG][search][WORK][BUILDER] [logo] [INSTAGRAM][CONTACT][account][bag]
      phones:   [menu][search]     [logo]     [account][bag]
  {%- endcomment -%}
  <header class="site-header" data-site-header>
    <nav class="site-header__bar" aria-label="{{ 'layout.header.menu' | t }}">

      <div class="site-header__half site-header__half--start">
        <button type="button" class="site-header__cell site-header__cell--icon site-header__menu-btn" data-door-open aria-controls="DoorMenu" aria-expanded="false" aria-label="{{ 'layout.header.menu' | t }}">{{ icon_menu }}</button>
        {%- if ig_url != blank -%}
          <a class="site-header__cell site-header__cell--icon site-header__desktop-only" href="{{ ig_url }}" target="_blank" rel="noopener" aria-label="Instagram">{{ icon_instagram }}</a>
        {%- endif -%}
        {{ search_cell }}
        <ul id="main-nav" class="main-nav site-header__links">
          {%- for link in menu.links -%}
            {%- if forloop.index0 < split_at -%}
              {% render 'navigation', link: link, menu: menu %}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
        <img src="{{ 'alexxburr-mark.png' | asset_url }}" alt="{{ shop.name }}" width="557" height="641" itemprop="logo">
      </a>

      <div class="site-header__half site-header__half--end">
        <ul class="main-nav site-header__links">
          {%- for link in menu.links -%}
            {%- if forloop.index0 >= split_at -%}
              {% render 'navigation', link: link, menu: menu %}
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {{ account_cell }}
        {{ bag_cell }}
      </div>
    </nav>
  </header>

  {%- comment -%} Full screen search, replaces the old inline #searchbox. {%- endcomment -%}
  <div class="search-overlay" id="SearchOverlay" data-search-overlay hidden>
    <div class="search-overlay__backdrop" data-search-close></div>
    <div class="search-overlay__panel" role="dialog" aria-modal="true" aria-label="{{ 'general.search.placeholder' | t }}">
      <form action="{{ routes.search_url }}" method="get" class="search-overlay__form" role="search">
        <span class="search-overlay__icon">{{ icon_search }}</span>
        <input
          type="search"
          name="q"
          class="search-overlay__input"
          placeholder="{{ 'general.search.placeholder' | t }}"
          autocomplete="off"
          data-search-input>
        {% if settings.search_products %}<input type="hidden" name="type" value="product">{% endif %}
      </form>
      <button type="button" class="search-overlay__close" data-search-close aria-label="{{ 'general.search.title' | t }}">
        <svg class="site-header__svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5L5 19"/></svg>
      </button>
    </div>
  </div>

  <style>
    #shopify-section-{{ section.id }} {
      --header-height: {{ section.settings.bar_height }}px;
      --header-height-mobile: {{ section.settings.bar_height_mobile }}px;
      --header-announcement-text-size: {{ section.settings.announcement_text_size }}px;
      --header-announcement-bg: {{ section.settings.announcement_background }};
      --header-announcement-color: {{ section.settings.announcement_color }};
    }
  </style>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "header", "content": "Announcement Bar" },
    {
      "type": "checkbox",
      "default": true,
      "id": "show_announcement_text",
      "label": "Show announcement text"
    },
    {
      "type": "richtext",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "<p>Share a shop announcement or message</p>"
    },
    {
      "type": "range",
      "id": "announcement_text_size",
      "min": 10, "max": 24, "step": 1, "unit": "px",
      "label": "Text size",
      "default": 12
    },
    { "type": "color", "id": "announcement_background", "label": "Background", "default": "#111111" },
    { "type": "color", "id": "announcement_color", "label": "Text", "default": "#ffffff" },

    { "type": "header", "content": "Bar" },
    {
      "type": "range",
      "id": "bar_height",
      "min": 44, "max": 88, "step": 2, "unit": "px",
      "label": "Height on desktop",
      "default": 64
    },
    {
      "type": "range",
      "id": "bar_height_mobile",
      "min": 40, "max": 72, "step": 2, "unit": "px",
      "label": "Height on phones",
      "default": 56
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram link",
      "info": "Defaults to the Instagram handle in theme settings. Shown as an icon on desktop."
    },

    { "type": "header", "content": "Navigation" },
    {
      "type": "link_list",
      "id": "main_nav",
      "label": "Choose main menu",
      "default": "main-menu"
    },
    {
      "type": "range",
      "id": "links_left",
      "min": 0, "max": 8, "step": 1,
      "label": "Links left of the logo",
      "default": 0,
      "info": "0 splits the menu down the middle automatically. Raise it to move the break point."
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega menu",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Menu item",
          "info": "Enter menu item to apply a mega menu"
        },
        { "type": "image_picker", "id": "nav_image", "label": "Featured image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
