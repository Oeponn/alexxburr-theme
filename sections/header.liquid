{%- assign hd_locale_selector = false -%}
{%- assign hd_currency_selector = false -%}

{%- if section.settings.show_currency_selector and shop.enabled_currencies.size > 1 -%}
  {%- assign hd_currency_selector = true -%}
{%- endif -%}

{%- if section.settings.show_locale_selector and shop.published_locales.size > 1 -%}
  {%- assign hd_locale_selector = true -%}
{%- endif -%}

{%- assign menu = linklists[section.settings.main_nav] -%}
{%- assign link_count = menu.links.size -%}

{%- comment -%}
  Where the menu breaks around the logo. 0 (the default) splits at the midpoint
  with any odd link falling on the left, which is what the sketch shows for a
  four link menu. Anything higher is used verbatim so the split can be nudged
  from the theme editor without touching the menu itself.
{%- endcomment -%}
{%- assign split_at = section.settings.links_left -%}
{%- if split_at == 0 -%}
  {%- assign split_at = link_count | plus: 1 | divided_by: 2 -%}
{%- endif -%}
{%- if split_at > link_count -%}
  {%- assign split_at = link_count -%}
{%- endif -%}

{%- capture logo_mark -%}
  {%- if section.settings.logo != blank -%}
    <img
      src="{{ section.settings.logo | image_url: width: 400 }}"
      alt="{{ section.settings.logo.alt | default: shop.name }}"
      itemprop="logo"
      width="{{ section.settings.logo.width }}"
      height="{{ section.settings.logo.height }}">
  {%- else -%}
    <span class="site-header__logo-text">{{ shop.name }}</span>
  {%- endif -%}
{%- endcapture -%}

{{ 'header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header.js' | asset_url }}" defer></script>

<div class="header-section" data-section-id="{{ section.id }}" data-section-type="header-section">

  {%- if section.settings.show_announcement_text and section.settings.announcement_text != blank -%}
    {%- comment -%}
      Sits above the sticky header in normal flow, so it simply scrolls away
      rather than needing to be collapsed on scroll.
    {%- endcomment -%}
    <div class="announcement-bar">
      <div class="announcement-bar__inner">{{ section.settings.announcement_text }}</div>
    </div>
  {%- endif -%}

  <header class="site-header" data-site-header>
    <div class="site-header__bar{% unless section.settings.full_width_header %} site-header__bar--contained{% endunless %}">

      {%- comment -%} Left rail - socials. Slides out of frame on scroll. {%- endcomment -%}
      <div class="site-header__rail site-header__rail--start">
        <ul class="site-header__social">
          {% if settings.facebook_url != blank %}<li><a href="{{ settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook"><i class="fa fa-facebook" aria-hidden="true"></i></a></li>{% endif %}
          {% if settings.instagram_id != blank %}<li><a href="//instagram.com/{{ settings.instagram_id }}" target="_blank" rel="noopener" aria-label="Instagram"><i class="fa fa-instagram" aria-hidden="true"></i></a></li>{% endif %}
          {% if settings.twitter_url != blank %}<li><a href="{{ settings.twitter_url }}" target="_blank" rel="noopener" aria-label="Twitter"><i class="fa fa-twitter" aria-hidden="true"></i></a></li>{% endif %}
          {% if settings.pinterest_url != blank %}<li><a href="{{ settings.pinterest_url }}" target="_blank" rel="noopener" aria-label="Pinterest"><i class="fa fa-pinterest" aria-hidden="true"></i></a></li>{% endif %}
          {% if settings.tumblr_url != blank %}<li><a href="{{ settings.tumblr_url }}" target="_blank" rel="noopener" aria-label="Tumblr"><i class="fa fa-tumblr" aria-hidden="true"></i></a></li>{% endif %}
          {% if settings.youtube_url != blank %}<li><a href="{{ settings.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube"><i class="fa fa-youtube" aria-hidden="true"></i></a></li>{% endif %}
          {% if settings.snapchat_id != blank %}<li><a href="//snapchat.com/add/{{ settings.snapchat_id }}" target="_blank" rel="noopener" aria-label="Snapchat"><i class="fa fa-snapchat-ghost" aria-hidden="true"></i></a></li>{% endif %}
          {% if settings.weibo_id != blank %}<li><a href="//weibo.com/{{ settings.weibo_id }}" target="_blank" rel="noopener" aria-label="Weibo"><i class="fa fa-weibo" aria-hidden="true"></i></a></li>{% endif %}
        </ul>
      </div>

      {%- comment -%}
        The pill. A three column grid - two equal flexible tracks either side of
        an auto sized logo track. Equal 1fr tracks under intrinsic sizing means
        both halves take the width of the wider one, so the logo lands dead
        centre of the pill however uneven the two halves' text is.
      {%- endcomment -%}
      <nav class="site-header__nav" aria-label="{{ 'layout.header.menu' | t }}">

        <div class="site-header__nav-half site-header__nav-half--start">
          <button type="button" class="site-header__icon-btn site-header__mm-trigger mm-trigger" aria-label="{{ 'layout.header.menu' | t }}">
            <i class="fa fa-bars" aria-hidden="true"></i>
          </button>
          <ul id="main-nav" class="main-nav site-header__nav-list">
            {%- for link in menu.links -%}
              {%- if forloop.index0 < split_at -%}
                {% render 'navigation', link: link, menu: menu %}
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>

        <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
          {{ logo_mark }}
        </a>

        <div class="site-header__nav-half site-header__nav-half--end">
          <ul class="main-nav site-header__nav-list">
            {%- for link in menu.links -%}
              {%- if forloop.index0 >= split_at -%}
                {% render 'navigation', link: link, menu: menu %}
              {%- endif -%}
            {%- endfor -%}
          </ul>
          <a class="site-header__icon-btn site-header__mobile-cart" href="{{ routes.cart_url }}" aria-label="{{ 'layout.header.my_cart' | t }}">
            {% if section.settings.cart_icon == 'cart' %}
              <i class="fa fa-shopping-cart" aria-hidden="true"></i>
            {% else %}
              <i class="fa fa-shopping-bag" aria-hidden="true"></i>
            {% endif %}
            <span class="site-header__cart-count" data-cart-count>{{ cart.item_count }}</span>
          </a>
        </div>
      </nav>

      {%- comment -%} Right rail - search, account, selectors, cart. Slides out of frame on scroll. {%- endcomment -%}
      <div class="site-header__rail site-header__rail--end">
        <ul id="cart" class="site-header__actions">
          <li class="seeks">
            <button type="button" class="site-header__icon-btn" data-search-open aria-label="{{ 'general.search.placeholder' | t }}" aria-expanded="false" aria-controls="SearchOverlay">
              <i class="fa fa-search" aria-hidden="true"></i>
            </button>
          </li>

          {% if shop.customer_accounts_enabled %}
            {% if customer %}
              <li class="cust"><a href="{{ routes.account_url }}" aria-label="{{ 'layout.mobile_nav.account' | t }}"><i class="fa fa-user" aria-hidden="true"></i></a></li>
              <li class="cust"><a href="{{ routes.account_logout_url }}" aria-label="{{ 'layout.mobile_nav.logout' | t }}"><i class="fa fa-sign-out" aria-hidden="true"></i></a></li>
            {% else %}
              <li class="cust"><a href="{{ routes.account_login_url }}" aria-label="{{ 'layout.mobile_nav.login' | t }}"><i class="fa fa-user" aria-hidden="true"></i></a></li>
            {% endif %}
          {% endif %}

          {%- if hd_locale_selector -%}
            <li class="lang-selector">
              {%- form 'localization', class: 'selectors-form' -%}
                <div class="selectors-form__item">
                  <h2 class="visually-hidden" id="lang-heading">{{ 'general.language.dropdown_label' | t }}</h2>
                  <div class="disclosure" data-disclosure-locale>
                    <button type="button" class="disclosure__toggle" aria-expanded="false" aria-controls="lang-list" aria-describedby="lang-heading" data-disclosure-toggle>
                      {{ form.current_locale.iso_code }}
                    </button>
                    <ul id="lang-list" class="disclosure-list" data-disclosure-list>
                      {% for locale in form.available_locales %}
                        <li class="disclosure-list__item {% if locale.iso_code == form.current_locale.iso_code %}disclosure-list__item--current{% endif %}">
                          <a class="disclosure-list__option" href="#" lang="{{ locale.iso_code }}" {% if locale.iso_code == form.current_locale.iso_code %}aria-current="true"{% endif %} data-value="{{ locale.iso_code }}" data-disclosure-option>
                            {{ locale.endonym_name }}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                    <input type="hidden" name="locale_code" id="LocaleSelector" value="{{ form.current_locale.iso_code }}" data-disclosure-input/>
                  </div>
                </div>
              {%- endform -%}
            </li>
          {%- endif -%}

          {%- if hd_currency_selector -%}
            <li class="curr-selector">
              {%- form 'localization', class: 'selectors-form' -%}
                <div class="selectors-form__item">
                  <h2 class="visually-hidden" id="currency-heading">{{ 'general.currency.dropdown_label' | t }}</h2>
                  <div class="disclosure" data-disclosure-currency>
                    <button type="button" class="disclosure__toggle" aria-expanded="false" aria-controls="currency-list" aria-describedby="currency-heading" data-disclosure-toggle>
                      {{ form.current_currency.iso_code }}{%- if form.current_currency.symbol -%}{{ form.current_currency.symbol }}{%- endif -%}
                    </button>
                    <ul id="currency-list" class="disclosure-list" data-disclosure-list>
                      {% for currency in form.available_currencies %}
                        <li class="disclosure-list__item {% if currency.iso_code == form.current_currency.iso_code %}disclosure-list__item--current{% endif %}">
                          <a class="disclosure-list__option" href="#" {% if currency.iso_code == form.current_currency.iso_code %}aria-current="true"{% endif %} data-value="{{ currency.iso_code }}" data-disclosure-option>
                            {{ currency.iso_code }}{%- if currency.symbol -%}{{ currency.symbol }}{%- endif -%}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                    <input type="hidden" name="currency_code" id="CurrencySelector" value="{{ form.current_currency.iso_code }}" data-disclosure-input/>
                  </div>
                </div>
              {%- endform -%}
            </li>
          {%- endif -%}

          <li>
            <a class="my-cart-link" href="{{ routes.cart_url }}">
              <span class="my-cart-text">{{ 'layout.header.my_cart' | t }}</span>
              {% if section.settings.cart_icon == 'cart' %}
                <i class="fa fa-shopping-cart" aria-hidden="true"></i>
              {% else %}
                <i class="fa fa-shopping-bag" aria-hidden="true"></i>
              {% endif %}
              <span id="item_count" data-cart-count>{{ cart.item_count }}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </header>

  {%- comment -%} Full screen search, replaces the old inline #searchbox. {%- endcomment -%}
  <div class="search-overlay" id="SearchOverlay" data-search-overlay hidden>
    <div class="search-overlay__backdrop" data-search-close></div>
    <div class="search-overlay__panel" role="dialog" aria-modal="true" aria-label="{{ 'general.search.placeholder' | t }}">
      <form action="{{ routes.search_url }}" method="get" class="search-overlay__form" role="search">
        <i class="fa fa-search search-overlay__icon" aria-hidden="true"></i>
        <input
          type="search"
          name="q"
          class="search-overlay__input"
          placeholder="{{ 'general.search.placeholder' | t }}"
          autocomplete="off"
          data-search-input>
        {% if settings.search_products %}<input type="hidden" name="type" value="product">{% endif %}
      </form>
      <button type="button" class="search-overlay__close" data-search-close aria-label="{{ 'general.search.title' | t }}">
        <i class="fa fa-times" aria-hidden="true"></i>
      </button>
    </div>
  </div>

  <style>
    #shopify-section-{{ section.id }} {
      --header-row-height: {{ section.settings.nav_height }}px;

      --header-logo-top: {{ section.settings.logo_size_top }}px;
      --header-logo-scrolled: {{ section.settings.logo_size_scrolled }}px;
      --header-logo-mobile: {{ section.settings.logo_size_mobile }}px;

      --header-nav-font-top: {{ section.settings.nav_font_size_top }}px;
      --header-nav-font-scrolled: {{ section.settings.nav_font_size_scrolled }}px;

      --header-logo-font-size: {{ section.settings.logo_size }}px;
      --header-logo-text-transform: {{ section.settings.logo_transform }};

      --header-announcement-text-size: {{ section.settings.announcement_text_size }}px;
      --header-announcement-bg: {{ section.settings.announcement_background }};
      --header-announcement-color: {{ section.settings.announcement_color }};

      --header-pill-border-width: {{ section.settings.pill_border_width }}px;
      --header-shade: {{ section.settings.shading_strength | divided_by: 100.0 }};
      --header-pill-border-color: {{ section.settings.pill_border_color }};
      --header-pill-bg: {{ section.settings.pill_background }};
      --header-pill-bg-scrolled: {{ section.settings.pill_background_scrolled }};

      --header-bg: {{ section.settings.header_background }};
      --header-color: {{ settings.header_icons }};
      --header-mobile-icons-color: {{ settings.mobile_header_icons }};
      --header-mobile-inset: {{ section.settings.mobile_inset }}px;
    }
  </style>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width_header",
      "label": "Enable full width",
      "default": false,
      "info": "Spans the header rails edge to edge instead of holding them to the page container."
    },
    {
      "type": "color",
      "id": "header_background",
      "label": "Background at top of page",
      "default": "#ffffff",
      "info": "Fades out as the page scrolls so the menu floats over the content."
    },

    { "type": "header", "content": "Announcement Bar" },
    {
      "type": "checkbox",
      "default": true,
      "id": "show_announcement_text",
      "label": "Show announcement text"
    },
    {
      "type": "richtext",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "<p>Share a shop announcement or message</p>"
    },
    {
      "type": "range",
      "id": "announcement_text_size",
      "min": 10, "max": 24, "step": 1, "unit": "px",
      "label": "Text size",
      "default": 12
    },
    { "type": "color", "id": "announcement_background", "label": "Background", "default": "#f5f5f5" },
    { "type": "color", "id": "announcement_color", "label": "Text", "default": "#262525" },

    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    {
      "type": "range",
      "id": "logo_size_top",
      "min": 56, "max": 180, "step": 4, "unit": "px",
      "label": "Logo size at top of page",
      "default": 104
    },
    {
      "type": "range",
      "id": "logo_size_scrolled",
      "min": 36, "max": 110, "step": 2, "unit": "px",
      "label": "Logo size once scrolled",
      "default": 62,
      "info": "Keep this a little larger than the navigation height so the circle still breaks out of the pill."
    },
    {
      "type": "range",
      "id": "logo_size_mobile",
      "min": 40, "max": 110, "step": 2, "unit": "px",
      "label": "Logo size on mobile",
      "default": 64
    },
    {
      "type": "range",
      "id": "logo_size",
      "min": 12, "max": 36, "step": 1, "unit": "px",
      "label": "Logo text size",
      "default": 18,
      "info": "Used only when no logo image is set."
    },
    {
      "type": "select",
      "id": "logo_transform",
      "label": "Logo text case",
      "default": "uppercase",
      "options": [
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "none", "label": "Normal" }
      ]
    },

    { "type": "header", "content": "Navigation" },
    {
      "type": "link_list",
      "id": "main_nav",
      "label": "Choose main menu",
      "default": "main-menu"
    },
    {
      "type": "range",
      "id": "links_left",
      "min": 0, "max": 8, "step": 1,
      "label": "Links left of the logo",
      "default": 0,
      "info": "0 splits the menu down the middle automatically. Raise it to move the break point."
    },
    {
      "type": "range",
      "id": "nav_height",
      "min": 30, "max": 80, "step": 2, "unit": "px",
      "label": "Navigation height",
      "default": 48
    },
    {
      "type": "range",
      "id": "nav_font_size_top",
      "min": 9, "max": 22, "step": 1, "unit": "px",
      "label": "Menu text size at top of page",
      "default": 14
    },
    {
      "type": "range",
      "id": "nav_font_size_scrolled",
      "min": 8, "max": 20, "step": 1, "unit": "px",
      "label": "Menu text size once scrolled",
      "default": 12
    },
    {
      "type": "range",
      "id": "pill_border_width",
      "min": 0, "max": 4, "step": 1, "unit": "px",
      "label": "Menu outline width",
      "default": 1
    },
    {
      "type": "color",
      "id": "pill_border_color",
      "label": "Menu outline",
      "default": "rgba(38,37,37,0.16)",
      "info": "A low opacity tint of the text colour reads far softer than a solid line."
    },
    {
      "type": "range",
      "id": "shading_strength",
      "min": 0, "max": 100, "step": 5, "unit": "%",
      "label": "Shading",
      "default": 40,
      "info": "Subtle top-to-bottom shading on the menu and logo so they sit off the page. 0 turns it off."
    },
    { "type": "color", "id": "pill_background", "label": "Menu background at top", "default": "#ffffff" },
    {
      "type": "color",
      "id": "pill_background_scrolled",
      "label": "Menu background once scrolled",
      "default": "rgba(255,255,255,0.72)",
      "info": "Sits behind a blur so the menu stays readable over imagery."
    },

    { "type": "header", "content": "Mobile" },
    {
      "type": "range",
      "id": "mobile_inset",
      "min": 0, "max": 40, "step": 2, "unit": "px",
      "label": "Gap from the screen edge",
      "default": 16,
      "info": "Holds the floating bar in from the sides of the screen."
    },

    { "type": "select", "id": "cart_icon", "label": "Cart icon", "default": "bag",
      "options": [
        { "value": "cart", "label": "Cart" },
        { "value": "bag", "label": "Bag" }
      ],
      "info": "You can change the text in your edit language section"
    },

    {
      "type": "header",
      "content": "Language Selector",
      "info": "To add a language, go to your [language settings.](/admin/settings/languages)"
    },
    { "type": "checkbox", "id": "show_locale_selector", "label": "Show language selector", "default": false },

    {
      "type": "header",
      "content": "Currency Selector",
      "info": "To add a currency, go to your [payment settings.](/admin/settings/payments)"
    },
    { "type": "checkbox", "id": "show_currency_selector", "label": "Show currency selector", "default": false }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega menu",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Menu item",
          "info": "Enter menu item to apply a mega menu"
        },
        { "type": "image_picker", "id": "nav_image", "label": "Featured image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
