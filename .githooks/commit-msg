#!/bin/sh
# Strip AI attribution from commit messages: Co-authored-by trailers for
# Copilot / Claude / other AI tools, "Generated with ..." footers, and
# Claude-Session links. Human co-authors are left alone.
#
# Enabled per clone with: git config core.hooksPath .githooks
# (Claude Code sessions do this automatically via .claude/settings.json.)

msg_file="$1"
tmp="$msg_file.tmp.$$"

grep -v -i -E \
  -e '^[[:space:]]*co-authored-by:.*(copilot|claude|anthropic|openai|chatgpt|gpt|cursor|codex|gemini|devin|aider|windsurf|codeium|\[bot\]|noreply@github\.com>)' \
  -e '^[[:space:]]*claude-session:' \
  -e '(generated|created|written) (with|by) .*(claude|copilot|chatgpt|cursor|codex|gemini)' \
  -e '^[[:space:]]*🤖' \
  "$msg_file" > "$tmp" || true

# Drop trailing blank lines left behind by removed trailers.
awk '{ lines[NR] = $0 } END { n = NR; while (n > 0 && lines[n] ~ /^[[:space:]]*$/) n--; for (i = 1; i <= n; i++) print lines[i] }' "$tmp" > "$msg_file"
rm -f "$tmp"
