/*
* Small screen overrides.
*
* Mobile first: the rules below the banner are the phone/tablet layout and apply
* unconditionally. The 980px block puts the desktop layout back. There is one
* small max-width block at the bottom for rules that can only be expressed that
* way - see the comment there.
*/

/* Cart ---------------------------------------------------------------------- */

#continue-shopping a {
  text-align: center;
  display: block;
  text-decoration: underline;
  padding: 8px;
}

h3.total-price {
  text-align: right;
}

#basket-right {
  text-align: center;
}

.add {
  width: 100%;
}

#shopping-cart thead {
  display: none;
}

#shopping-cart td {
  clear: left;
  display: block;
}

#shopping-cart tr {
  border-bottom: 1px solid {{ settings.dotted_color }};
}

.cart-title {
  display: block;
  text-align: center;
  margin-top: 20px;
  margin-bottom: 20px;
}

.cart-image {
  display: block;
  text-align: center;
}

td.cart-price {
  text-align: center;
}

/* !important is load-bearing here: #shopping-cart td above carries an id, so it
   outranks these selectors on specificity. */
td.cart-price,
td.cart-remove,
td.cart-quantity,
.cart-total {
  clear: none !important;
  float: left;
  width: 23%;
  margin: 1%;
  display: inline-block !important;
  line-height: 48px;
  border-bottom: 0 !important;
}

.ajaxifyCart--qty {
  margin-bottom: 10px;
}

#looked-at {
  display: none;
}

/* Sidebars and filters ------------------------------------------------------ */

.show {
  text-align: center;
  width: 100%;
  display: block;
  margin-bottom: 20px;
}

#sidebar {
  display: none;
  text-align: center;
}

#sidebar.open {
  display: block;
}

#sidebar ul li {
  padding: 5px 0;
}

#page-sidebar {
  margin-top: 20px;
  text-align: center;
}

ul#sortme li.filter {
  width: 100%;
  margin: 0 0 10px 0;
}

ul#sortme li.filter .styled-select {
  width: 100%;
  min-width: 100%;
}

div#full-width-filter .filter {
  width: 100%;
}

/* Product and collection grids ---------------------------------------------- */

/* Two up below the desktop breakpoint, so every odd card starts a new row. */
.first {
  clear: none;
}

.product-index:nth-child(2n + 1),
.article-index:nth-child(2n + 1),
.collection-index:nth-child(2n + 1) {
  clear: left;
}

.grid-item.mobile-full {
  width: 100%;
  clear: both;
}

.product-quick-view {
  width: 100%;
}

/* Misc ---------------------------------------------------------------------- */

.homepage-promo .promo-inner p {
  display: none;
  opacity: 0;
}

#subscribe_popup {
  width: 100%;
}

#subscribe_popup img {
  min-width: 280px;
}

.mobile-search-form form input {
  margin-bottom: 0;
}

/* Desktop ------------------------------------------------------------------- */

@media screen and (min-width: 980px) {
  #continue-shopping a {
    text-align: inherit;
    display: inline;
    text-decoration: none;
    padding: 0;
  }

  h3.total-price {
    text-align: inherit;
  }

  #basket-right {
    text-align: right;
  }

  .add {
    width: auto;
  }

  #shopping-cart thead {
    display: table-header-group;
  }

  #shopping-cart td {
    clear: none;
    display: table-cell;
  }

  #shopping-cart tr {
    border-bottom: 0;
  }

  .cart-title {
    display: inline-block;
    text-align: inherit;
    margin-top: 0;
    margin-bottom: 0;
  }

  .cart-image {
    display: inline-block;
    text-align: inherit;
  }

  /* Matches the !important in the small-screen rule above. */
  td.cart-price,
  td.cart-remove,
  td.cart-quantity,
  .cart-total {
    float: none;
    width: auto;
    margin: 0;
    display: table-cell !important;
    line-height: inherit;
  }

  td.cart-price {
    text-align: inherit;
  }

  .ajaxifyCart--qty {
    margin-bottom: 0;
  }

  #looked-at {
    display: block;
  }

  .show {
    display: none;
  }

  #sidebar {
    display: block;
    text-align: inherit;
  }

  #sidebar ul li {
    padding: 0;
  }

  #page-sidebar {
    margin-top: 0;
    text-align: inherit;
  }

  ul#sortme li.filter {
    width: auto;
    margin: 0;
  }

  ul#sortme li.filter .styled-select {
    width: auto;
    min-width: 0;
  }

  .first {
    clear: left;
  }

  .product-index:nth-child(2n + 1),
  .article-index:nth-child(2n + 1),
  .collection-index:nth-child(2n + 1) {
    clear: none;
  }

  .homepage-promo .promo-inner p {
    display: block;
    opacity: 1;
  }

  #subscribe_popup img {
    min-width: 0;
  }

  /* Row clearing for the desktop column counts. */
  .collection-index.desktop-6:nth-child(2n + 1),
  .collection-index.desktop-4:nth-child(3n + 1),
  .collection-index.desktop-3:nth-child(4n + 1) {
    clear: left;
  }

  .map-section-wrapper {
    height: 400px;
    margin-top: 20px;
  }
}

/*
* These two cannot be written mobile first. The slideshow caption sizes are set
* from sections/slideshow.liquid in an inline style block whose values come
* from section settings, so the only way to beat them on small screens is an
* !important override scoped to those screens - there is no fixed desktop value
* to restore. .product-modal likewise suppresses a hover-reveal rule.
*/
@media screen and (max-width: 979px) {
  .flex-caption {
    display: block !important;
    text-align: center !important;
    width: 100% !important;
  }

  .flex-caption h2.slide-title {
    font-size: 16px !important;
    margin-bottom: 5px !important;
  }

  .flex-caption p.caption {
    font-size: 14px !important;
  }

  .flex-caption .cta {
    margin-top: 15px !important;
  }

  .flex-caption .cta a {
    font-size: 14px !important;
    padding: 5px 8px !important;
  }

  .product-modal {
    display: none !important;
  }
}
